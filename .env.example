# Local PostgreSQL started by `docker compose up -d`
DATABASE_URL=postgresql://mandate:mandate_local@127.0.0.1:54329/mandate

# Public canonical MCP resource. Production must be the exact Alexa add-on URL.
MANDATE_MCP_RESOURCE_URL=https://localhost:3001/mcp
# Exact comma-separated browser origins; server-to-server requests normally omit Origin.
MANDATE_MCP_ALLOWED_ORIGINS=http://localhost:6274
# Leave unset until the OAuth 2.1 provider proves Alexa RFC 8707 resource binding.
# MANDATE_MCP_AUTHORIZATION_SERVER_URL=https://auth.example.com/

# Dashboard defaults to fixtures only when this is explicitly illustrative.
MANDATE_DASHBOARD_MODE=illustrative
MANDATE_CONTROL_PLANE_URL=https://control-plane.example/
# Never commit real values.
MANDATE_CONTROL_PLANE_CREDENTIAL=replace-with-server-only-credential
MANDATE_DASHBOARD_USERNAME=operator
MANDATE_DASHBOARD_PASSWORD=replace-with-local-password
